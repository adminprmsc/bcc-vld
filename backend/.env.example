# Backend environment configuration
# Copy to .env and fill in secure values before running locally or in production.
# For Docker deployment, use the repo-root .env with docker-compose.yml.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL (required in production)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lds_db
POSTGRES_USER=lds_user
POSTGRES_PASSWORD=<GENERATE_SECURE_PASSWORD>
# Or set a single connection string:
# DATABASE_URL=postgresql://lds_user:password@localhost:5432/lds_db

JWT_SECRET=<GENERATE_64_CHAR_HEX_SECRET>
JWT_EXPIRES_IN=24h

ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX=10

MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

LOG_LEVEL=info
LOG_FORMAT=combined
AUDIT_READS=false
