# Backend environment configuration
# Copy to .env and fill in secure values before running locally or in production.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (MySQL or MongoDB depending on deployment)
# MONGO_URI=mongodb://lds_user:password@localhost:27017/landdonation?authSource=landdonation
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=landdonation
# DB_USER=lds_user
# DB_PASSWORD=<GENERATE_SECURE_PASSWORD>

JWT_SECRET=<GENERATE_64_CHAR_HEX_SECRET>
JWT_EXPIRES_IN=24h

ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX=10

MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

LOG_LEVEL=info
LOG_FORMAT=combined
