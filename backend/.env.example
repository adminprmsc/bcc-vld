# Backend environment configuration (MySQL only — no MongoDB)
# Copy to .env and fill in secure values before running locally or in production.
# For Docker production deployment, use the repo-root .env with docker-compose.yml.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# MySQL (required in production)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=lds_db
MYSQL_USER=lds_user
MYSQL_PASSWORD=<GENERATE_SECURE_PASSWORD>
MYSQL_TEST_DATABASE=lds_db_test
# MYSQL_SSL=true

JWT_SECRET=<GENERATE_64_CHAR_HEX_SECRET>
JWT_EXPIRES_IN=24h

# Comma-separated allowed origins (use ALLOWED_ORIGINS, not CORS_ORIGIN)
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX=10

MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

LOG_LEVEL=info
LOG_FORMAT=combined
AUDIT_READS=false
