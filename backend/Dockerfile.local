# Local Mac builds — deps installed on host (avoids Docker Desktop npm SSL bug)
# Use: ./deploy/local.sh build
FROM node:22-bookworm-slim AS base

ENV NODE_ENV=production

RUN apt-get update && apt-get install -y --no-install-recommends dumb-init ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN groupadd -g 1001 nodejs && \
    useradd -u 1001 -g nodejs -m nodejs

COPY package*.json ./
COPY node_modules ./node_modules

COPY --chown=nodejs:nodejs . .

RUN mkdir -p uploads/mobile uploads/documents && \
    chown -R nodejs:nodejs uploads

USER nodejs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))"

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "./bin/www"]
