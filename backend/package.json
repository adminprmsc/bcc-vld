{
  "name": "backend",
  "version": "1.0.0",
  "description": "LDS Backend API Server",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "start:prod": "NODE_ENV=production node ./bin/www",
    "seed:admin": "node ./scripts/seed-admin.js",
    "seed:water-users": "node ./scripts/seed-water-quality-users.js",
    "db:migrate": "node scripts/run-migrations.js",
    "db:migrate:status": "node scripts/run-migrations.js status",
    "db:migrate:generate": "sequelize-cli migration:generate",
    "health": "curl -s http://localhost:${PORT:-3000}/health || echo 'Server not running'"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.2.1",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "mysql2": "^3.18.1",
    "pdfkit": "^0.15.2",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.5",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  }
}
