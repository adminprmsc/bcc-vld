ALLOWED_ORIGINS=http://101.50.85.111,https://101.50.85.111

JWT_SECRET=CHANGE_ME_openssl_rand_hex_64
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_USER=lds_user
POSTGRES_PASSWORD=ChangeThisDbPass123!
POSTGRES_DB=lds_db
POSTGRES_BIND=127.0.0.1
# Host port on the VM (maps to 5432 inside the container)
POSTGRES_PORT=3306

# First deploy — admin login (change password after first login)
REQUIRE_STRONG_ADMIN_PASSWORD=true
SEED_ADMIN_EMAIL=admin@lds.gov.pk
SEED_ADMIN_PASSWORD=ChangeThisAdminPass123!

BACKUP_RETENTION_DAYS=90
