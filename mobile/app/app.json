{
  "expo": {
    "name": "LDS Field Operations",
    "slug": "lds-field-operations",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ldsfieldops",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#2563EB"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lds.fieldoperations"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563EB"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "package": "com.lds.fieldoperations",
      "versionCode": 1
    },
    "plugins": [
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2563EB",
          "sounds": []
        }
      ],
      "expo-secure-store",
      [
        "@rnmapbox/maps/app.plugin.js",
        {
          "RNMapboxMapsImpl": "maplibre",
          "RNMapboxV10": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 24,
            "usesCleartextTraffic": true
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LDS Field Operations to access your camera for capturing site photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LDS Field Operations to access your photos for attaching to forms."
        }
      ]
    ],
    "extra": {
      "environment": "development",
      "api": {
        "production": "https://api.lds.pk",
        "staging": "https://staging-api.lds.pk",
        "development": "http://192.168.1.100:3000"
      },
      "apiUrl": "http://192.168.1.100:3000",
      "syncQueueKey": "lds-sync-queue",
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
