# =================================================================
# LDS Production — Docker Compose Environment
# =================================================================
# Copy to .env and fill in secure values before deploying:
#   cp .env.example .env
#
# Generate secrets:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =================================================================

# -------------------- Public URLs (CORS + cookies) --------------------
# Comma-separated origins allowed for direct API access (mobile apps, etc.)
# Browser SPA traffic uses /api on the same domain — no CORS needed.
# Example: https://lds.yourdomain.pk,https://www.lds.yourdomain.pk
ALLOWED_ORIGINS=https://YOUR_DOMAIN

# -------------------- HTTP / HTTPS ports (host) --------------------
HTTP_PORT=80
HTTPS_PORT=443

# -------------------- MySQL --------------------
MYSQL_ROOT_PASSWORD=<GENERATE_SECURE_PASSWORD_32_CHARS>
MYSQL_DATABASE=lds_db
MYSQL_USER=lds_user
MYSQL_PASSWORD=<GENERATE_SECURE_PASSWORD_32_CHARS>

# -------------------- JWT --------------------
JWT_SECRET=<GENERATE_64_CHAR_HEX_SECRET>

# -------------------- Optional --------------------
AUDIT_READS=false
