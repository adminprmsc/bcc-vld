# =================================================================
# Docker Compose Environment Configuration (repo root)
# =================================================================
# Used by docker-compose.yml to wire mongo, backend, and frontend.
# For local backend development, use backend/.env.example instead.
#
# Copy this file to .env and fill in secure values.
# NEVER commit .env files with real credentials to version control.
# =================================================================

# -------------------- Node Environment --------------------
NODE_ENV=production

# -------------------- MongoDB Configuration --------------------
# Root credentials for MongoDB admin (used by Docker init)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=<GENERATE_SECURE_PASSWORD_32_CHARS>

# Application database credentials
MONGO_USER=lds_user
MONGO_PASSWORD=<GENERATE_SECURE_PASSWORD_32_CHARS>

# Full MongoDB connection string (optional - if not using Docker)
# MONGO_URI=mongodb://lds_user:password@mongodb-server:27017/landdonation?authSource=landdonation

# -------------------- JWT Configuration --------------------
# CRITICAL: Generate a strong random secret (minimum 32 characters)
# Command to generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<GENERATE_64_CHAR_HEX_SECRET>

# Token expiration (default: 24 hours)
JWT_EXPIRES_IN=24h

# -------------------- Server Configuration --------------------
PORT=3000
HOST=0.0.0.0

# -------------------- CORS Configuration --------------------
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# -------------------- Rate Limiting --------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX=10

# -------------------- File Upload --------------------
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=/app/uploads

# -------------------- Logging --------------------
LOG_LEVEL=info
LOG_FORMAT=combined

# -------------------- Optional: Email Configuration --------------------
# For password reset, notifications, etc.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=<SMTP_PASSWORD>
# SMTP_FROM=LDS System <noreply@example.com>

# -------------------- Optional: External Services --------------------
# Map tile service API key (if using premium tiles)
# MAPTILER_API_KEY=<YOUR_API_KEY>

# -------------------- Optional: Monitoring --------------------
# Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@sentry.io/xxx

# -------------------- Optional: Backup Configuration --------------------
# Backup storage path
# BACKUP_PATH=/backups
# BACKUP_RETENTION_DAYS=30
