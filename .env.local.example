# Mac — cp .env.local.example .env

# App
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:4200
JWT_SECRET=local_dev_change_me_openssl_rand_hex_64
HTTP_PORT=80

# MySQL (Docker)
MYSQL_ROOT_PASSWORD=LocalRootPass123!
MYSQL_DATABASE=lds_db
MYSQL_USER=lds_user
MYSQL_PASSWORD=LocalDbPass123!
MYSQL_BIND=127.0.0.1
MYSQL_PORT=3306

# Backup server DB to this Mac (optional — for sync-backup)
LDS_SERVER_HOST=101.50.85.111
LDS_SSH_USER=root
LDS_SSH_KEY=/path/to/bcc-vld-key
LDS_REMOTE_DIR=/opt/lds
LDS_MAC_BACKUP_DIR=./backups-from-server
