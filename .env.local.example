# Mac — cp .env.local.example .env

# App
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:4200
JWT_SECRET=local_dev_change_me_openssl_rand_hex_64
HTTP_PORT=80

# PostgreSQL (Docker)
POSTGRES_USER=lds_user
POSTGRES_PASSWORD=LocalDbPass123!
POSTGRES_DB=lds_db
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=15432

# Pull production backup to this Mac (./deploy/local.sh pull-backup)
LDS_SERVER_HOST=101.50.85.111
LDS_SSH_USER=root
LDS_SSH_KEY=/path/to/your-ssh-key
LDS_REMOTE_DIR=/opt/lds
LDS_MAC_BACKUP_DIR=./backups-from-server
